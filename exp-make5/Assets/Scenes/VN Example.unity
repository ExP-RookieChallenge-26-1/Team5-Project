  - speakerName: "\uC218\uBB38\uC7A5"
    text: "\uC81C...\uC81C\uAC00 \uC0AC\uB78C\uC774 \uB418\uB294 \uBC29\uBC95\uC744
      \uCC3E\uC544 \uC624\uACA0\uC2B5\uB2C8\uB2E4. \uC54C\uB9CC\uD55C \uC0AC\uB78C\uC774
      \uC788\uC2B5\uB2C8\uB2E4"
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uBC94"
    text: "\uACE0\uB9D9\uB124. \uC774\uB807\uAC8C \uB3C4\uC6C0\uC744 \uC8FC\uB2C8
      \uB098\uB3C4 \uBB34\uC5B8\uAC00 \uB3C4\uC6C0\uC744 \uC8FC\uACA0\uB124. \uD544\uC694\uD55C
      \uAC83\uC774 \uC788\uB294\uAC00?"
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uC218\uBB38\uC7A5"
    text: "\uADF8\uB7FC \uC81C\uAC00 \uC548\uCABD\uC5D0\uC11C \uBC29\uBC95\uC744
      \uCC3E\uC544\uC624\uB294 \uB3D9\uC548 \uC131 \uC678\uBD80\uC5D0 \uAC15\uAC00\uC5D0\uC11C
      \uD5A5\uB85C \uC870\uAC01\uC744 \uCC3E\uC544\uC8FC\uC2ED\uC2DC\uC624."
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uBC94"
    text: "\uB0B4\uAC00 \uC774\uB7F0 \uB9D0\uC744 \uD560 \uAC70\uB77C\uACE0 \uC608\uC0C1\uD55C
      \uC0AC\uB78C\uCC98\uB7FC \uBD80\uD0C1\uC744 \uD558\uB294\uAD70?"
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uBC94"
    text: "... \uBC49\uC740 \uB9D0\uC774 \uC788\uC73C\uB2C8 \uB3C4\uC640\uC8FC\uACA0\uB124."
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uC218\uBB38\uC7A5"
    text: "\uC544\uCE68\uC774 \uB418\uAE30 \uC804\uAE4C\uC9C0 \uD5A5\uB85C \uC870\uAC01\uC744
      \uCC3E\uC544\uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4. \uBC24\uC5D0 \uAC15 \uADFC\uCC98\uB97C
      \uAC00\uBA74 \uBD89\uAC8C \uBCF4\uC774\uB294 \uADC0\uC2E0\uACFC \uD30C\uB797\uAC8C
      \uBCF4\uC774\uB294 \uADC0\uC2E0\uC774 \uC788\uB294\uB370 \uC870\uC2EC\uD558\uC154\uC57C
      \uD569\uB2C8\uB2E4."
    characterObject: {fileID: 0}
    hideCharacter: 0
    bounceCharacter: 0
    pauseAfterLine: 0.5
  - speakerName: "\uBC94"
    text: "\uC544\uCE68\uC774 \uB418\uAE30 \uC804\uAE4C\uC9C0 \uD5A5\uB85C \uC870\uAC01\uC744
